<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme using Material3 and Ocean Professional -->
    <style name="Theme.NotificationSSH" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- Light surfaces -->
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <!-- Remove invalid colorBackground attr on some libraries; Material3 infers background from surface/window -->
        <!-- Keeping onBackground only for text semantics -->
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Typography: Reddit Sans app-wide -->
        <item name="fontFamily">@font/reddit_sans</item>
        <item name="android:fontFamily">@font/reddit_sans</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.NotificationSSH.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.NotificationSSH.BodyMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.NotificationSSH.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.NotificationSSH.TitleMedium</item>

        <!-- Buttons elevation/padding kept Material3 defaults; using expressive containers in layouts -->
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <!-- Typography styles referencing Reddit Sans -->
    <style name="TextAppearance.NotificationSSH.Base" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/reddit_sans</item>
        <item name="android:fontFamily">@font/reddit_sans</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="TextAppearance.NotificationSSH.BodyLarge" parent="TextAppearance.NotificationSSH.Base">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.NotificationSSH.BodyMedium" parent="TextAppearance.NotificationSSH.Base">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.NotificationSSH.TitleLarge" parent="TextAppearance.NotificationSSH.Base">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.NotificationSSH.TitleMedium" parent="TextAppearance.NotificationSSH.Base">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

</resources>
