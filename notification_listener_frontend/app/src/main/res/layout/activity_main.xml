<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:clipToPadding="false">

        <!-- Header -->
        <TextView
            android:id="@+id/txtHeader"
            style="@style/TextAppearance.NotificationSSH.TitleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/txtSubtitle"
            style="@style/TextAppearance.NotificationSSH.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.8"
            android:layout_marginTop="8dp" />

        <!-- Permission status card -->
        <LinearLayout
            android:id="@+id/cardPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/colorPrimaryContainer"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:clipToPadding="false"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/imgPermStatus"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_shield_check"
                android:contentDescription="@string/notification_access_status_icon_desc"
                app:tint="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/txtPermTitle"
                    style="@style/TextAppearance.NotificationSSH.TitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notification_access_title"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/txtPermStatus"
                    style="@style/TextAppearance.NotificationSSH.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notif_access_not_granted"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.9" />
            </LinearLayout>

            <Button
                android:id="@+id/btnGrantNotifAccess"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cta_grant_access" />
        </LinearLayout>

        <!-- Post notifications permission (Android 13+) -->
        <Button
            android:id="@+id/btnRequestPostNotifications"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cta_post_notifications"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Last status/result -->
        <LinearLayout
            android:id="@+id/sectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="?attr/colorSecondaryContainer"
            android:elevation="2dp">

            <TextView
                android:id="@+id/txtStatusHeader"
                style="@style/TextAppearance.NotificationSSH.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_header"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txtLastResult"
                style="@style/TextAppearance.NotificationSSH.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_result_never"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txtLastStatus"
                style="@style/TextAppearance.NotificationSSH.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_status_never"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/sectionActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btnOpenSettings"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/open_settings" />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnOpenAppSelection"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_apps"
                android:text="@string/open_app_selection" />
        </LinearLayout>

        <!-- Test SSH -->
        <LinearLayout
            android:id="@+id/sectionTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:padding="16dp"
            android:background="?attr/colorPrimaryContainer"
            android:elevation="2dp">

            <TextView
                android:id="@+id/txtTestTitle"
                style="@style/TextAppearance.NotificationSSH.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_ssh_title"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txtTestHint"
                style="@style/TextAppearance.NotificationSSH.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/test_ssh_hint"
                android:alpha="0.85"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnTestSsh"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_ssh" />

                <TextView
                    android:id="@+id/txtTestResult"
                    style="@style/TextAppearance.NotificationSSH.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Awaiting..." />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</ScrollView>
